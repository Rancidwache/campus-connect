# Copy to deploy/.env and fill in. Consumed by deploy/docker-compose.yml.

# Public URL the stack is served on (used for CORS + M-Pesa callback URLs).
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080

# ── Database (Supabase) ──
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5
DIRECT_URL=postgresql://postgres.xxxx:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# ── Auth ──
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── M-Pesa ── (mock needs nothing else; sandbox/production need the rest)
MPESA_MODE=mock
PLATFORM_FEE_RATE=0.10
MPESA_CALLBACK_SECRET=change-me
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_B2C_SHORTCODE=
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=

# ── SMS ──
SMS_PROVIDER=console
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=CAMPUSCONN

# ── Media storage ──
STORAGE_DRIVER=supabase
STORAGE_BUCKET=campus-connect-media
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
