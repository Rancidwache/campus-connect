# Dependencies
node_modules/

# Environment & secrets — only the *.example templates are ever committed
.env
.env.*
!.env.example
*.local
deploy/.env
*.pem
*.key
*.p12
*.pfx
*.keystore
service-account*.json
*credentials*.json
secrets.*

# Build output
dist/
build/
web/dev-dist/

# Logs
*.log
npm-debug.log*

# Prisma / DB
server/prisma/*.db
server/prisma/*.db-journal

# Local PGlite dev database (DB_DRIVER=pglite) — fast local demo DB, not synced anywhere
server/.localdb/

# Locally-stored uploads (STORAGE_DRIVER=local)
server/uploads/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
