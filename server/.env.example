# ── Core ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed web origins
CORS_ORIGIN=http://localhost:5173
# Set to 1 when running behind Kong / a reverse proxy that sets X-Forwarded-*
TRUST_PROXY=0

# ── Database ─────────────────────────────────────────────────────────
# Local Postgres / Docker: both URLs are the same.
# Supabase: DATABASE_URL = transaction pooler (port 6543) + ?pgbouncer=true&connection_limit=5
#           DIRECT_URL   = direct connection or session pooler (port 5432)
DATABASE_URL="postgresql://campusconnect:campusconnect@localhost:5432/campusconnect?schema=public"
DIRECT_URL="postgresql://campusconnect:campusconnect@localhost:5432/campusconnect?schema=public"

# ── Auth ────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── OTP / SMS ───────────────────────────────────────────────────────
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
# console  -> logs the OTP to the server console (development)
# africastalking -> uses the Africa's Talking API (fill creds below)
SMS_PROVIDER=console
# When true, verification-code responses include the code (DEV ONLY)
OTP_DEV_ECHO=true

# Africa's Talking (only needed when SMS_PROVIDER=africastalking)
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=CAMPUSCONN

# ── HustleGuard escrow / M-Pesa (Module 2) ──────────────────────────
# Public URL this API is reachable at (for M-Pesa callbacks). In mock mode the
# simulator also uses it to call its own webhooks. Use your ngrok URL for sandbox.
SELF_BASE_URL=http://localhost:4000
# mock -> no network, simulator fires realistic callbacks | sandbox | production
MPESA_MODE=mock
# Platform commission added on top of the listing price (0.10 = 10%)
PLATFORM_FEE_RATE=0.10
# Unguessable segment on the callback URLs (pair with a Safaricom IP allow-list)
MPESA_CALLBACK_SECRET=dev-callback-secret
# Mock only: delay before the simulated STK / B2C callback fires (ms)
MPESA_MOCK_DELAY_MS=4000

# Daraja credentials (only needed when MPESA_MODE=sandbox or production)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_B2C_SHORTCODE=
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
