// Campus Connect V2 data model — see docs/data-model.md and proposal section 4.3.
// Four primary entities: Users, Listings, Messages, Transactions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection for the running app. On Supabase this is the transaction
  // pooler (port 6543) with ?pgbouncer=true.
  url       = env("DATABASE_URL")
  // Unpooled connection used only for migrations / introspection. For a plain
  // local Postgres, set DIRECT_URL equal to DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

enum CategoryType {
  DIGITAL
  PHYSICAL
}

enum ListingStatus {
  ACTIVE
  PAUSED
  HIRED
  REMOVED // soft-deleted (kept so transaction history stays intact)
}

enum OtpPurpose {
  PHONE_VERIFY
  LOGIN
}

// The proposal's ERD names the three resting states (Held, Released, Refunded).
// The extra values are the operational transitions in between.
enum EscrowStatus {
  PENDING_PAYMENT // STK Push sent; waiting for the client's PIN + Safaricom callback
  PAYMENT_FAILED  // STK Push cancelled, wrong PIN, timed out, or insufficient funds
  HELD            // deposit confirmed and secured in escrow  ("Funds Secured")
  RELEASING       // B2C payout to the provider in flight
  RELEASED        // paid out to the provider                 ("Released")
  REFUNDING       // B2C refund to the client in flight
  REFUNDED        // returned to the client                   ("Refunded")
  CANCELLED       // client cancelled before paying
}

enum MpesaEventKind {
  STK_PUSH_REQUEST
  STK_CALLBACK
  B2C_REQUEST
  B2C_RESULT
  B2C_TIMEOUT
}

enum NotificationType {
  ESCROW_FUNDED
  PAYMENT_FAILED
  DELIVERY_APPROVED
  ESCROW_RELEASED
  ESCROW_REFUNDED
  JOB_DECLINED
  NEW_REVIEW
  REVIEW_REPLY
  DELIVERY_SUBMITTED // provider uploaded delivery-proof photos
  DELIVERY_DISPUTED  // client disputed the delivery — admin queue
}

enum MediaKind {
  IMAGE
  VIDEO
}

enum ReportTargetType {
  LISTING
  REVIEW
  REVIEW_REPLY
  USER
  TRANSACTION // delivery dispute — resolved by an admin releasing or refunding escrow
}

enum ReportReason {
  SPAM
  SCAM_OR_FRAUD
  PROHIBITED_ITEM
  HARASSMENT_OR_HATE
  OFF_PLATFORM_PAYMENT
  MISLEADING
  OTHER
  NOT_DELIVERED           // transaction disputes
  ITEM_NOT_AS_DESCRIBED   // transaction disputes
}

enum ReportStatus {
  OPEN
  REVIEWING
  ACTIONED
  DISMISSED
}

enum BugSeverity {
  LOW
  MEDIUM
  HIGH
}

enum BugStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  WONT_FIX
}

model User {
  id            Int      @id @default(autoincrement()) @map("user_id")
  userName      String   @map("user_name")
  phoneNumber   String   @unique @map("phone_number")
  passwordHash  String   @map("password_hash")
  phoneVerified Boolean  @default(false) @map("phone_verified")
  isAdmin       Boolean  @default(false) @map("is_admin")
  isSuspended   Boolean  @default(false) @map("is_suspended")
  publicKey     String?  @map("public_key")
  bio           String?
  avatarUrl     String?  @map("avatar_url")
  avatarKey     String?  @map("avatar_key")
  // { tiktok, instagram, whatsapp, x, facebook, youtube, linkedin, website } — all optional
  socials       Json?
  // Denormalised rating rollup — recomputed on any review change.
  ratingAvg     Float    @default(0) @map("rating_avg")
  ratingCount   Int      @default(0) @map("rating_count")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  listings               Listing[]
  otpCodes               OtpCode[]
  transactionsAsClient   Transaction[]  @relation("ClientTransactions")
  transactionsAsProvider Transaction[]  @relation("ProviderTransactions")
  messagesSent           Message[]      @relation("SentMessages")
  messagesReceived       Message[]      @relation("ReceivedMessages")
  notifications          Notification[]
  reviewsReceived        Review[]       @relation("ReviewsAboutProvider")
  reviewsWritten         Review[]       @relation("ReviewsByAuthor")
  reviewReplies          ReviewReply[]
  reviewLikes            ReviewLike[]
  replyLikes             ReplyLike[]
  favorites              Favorite[]
  reportsFiled            Report[]       @relation("ReportsByReporter")
  reportsHandled          Report[]       @relation("ReportsByModerator")
  bugReports              BugReport[]    @relation("BugReportsByUser")

  @@map("users")
}

model OtpCode {
  id         Int        @id @default(autoincrement())
  userId     Int        @map("user_id")
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String     @map("code_hash")
  purpose    OtpPurpose
  expiresAt  DateTime   @map("expires_at")
  consumedAt DateTime?  @map("consumed_at")
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([userId, purpose])
  @@map("otp_codes")
}

model Listing {
  id           Int           @id @default(autoincrement()) @map("listing_id")
  userId       Int           @map("user_id")
  owner        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryType CategoryType  @map("category_type")
  category     String
  title        String
  description  String
  price        Decimal       @db.Decimal(12, 2)
  location     String?
  status       ListingStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  transactions Transaction[]
  media        ListingMedia[]
  favorites    Favorite[]

  @@index([categoryType, status])
  @@index([createdAt])
  @@index([category])
  @@map("listings")
}

// Saved / favourited listings.
model Favorite {
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId Int      @map("listing_id")
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, listingId])
  @@index([userId])
  @@map("favorites")
}

// Up to 5 images + one short video per listing. Files live in object storage
// (Supabase Storage in production, local disk in dev — see src/lib/storage.js).
model ListingMedia {
  id         Int       @id @default(autoincrement())
  listingId  Int       @map("listing_id")
  listing    Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  kind       MediaKind
  url        String
  storageKey String    @map("storage_key")
  position   Int        @default(0)
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([listingId])
  @@map("listing_media")
}

// ── Module 2 — HustleGuard escrow ──
model Transaction {
  id         Int     @id @default(autoincrement()) @map("transaction_id")
  listingId  Int     @map("listing_id")
  listing    Listing @relation(fields: [listingId], references: [id])
  clientId   Int     @map("client_id")
  client     User    @relation("ClientTransactions", fields: [clientId], references: [id])
  providerId Int     @map("provider_id")
  provider   User    @relation("ProviderTransactions", fields: [providerId], references: [id])

  currency    String  @default("KES")
  feeAmount   Decimal @map("fee_amount") @db.Decimal(12, 2) // the provider's payout
  platformFee Decimal @map("platform_fee") @db.Decimal(12, 2) // Campus Connect commission
  amount      Decimal @db.Decimal(12, 2) // total charged to the client (fee + platformFee)

  escrowStatus  EscrowStatus @default(PENDING_PAYMENT) @map("escrow_status")
  clientPhone   String       @map("client_phone") // E.164 snapshot — STK Push target
  providerPhone String       @map("provider_phone") // E.164 snapshot — B2C payout target

  // Client disputed the provider's delivery proof (or lack of it) — open
  // until an admin force-releases or force-refunds the escrow.
  disputed Boolean @default(false)

  // STK Push (deposit collection)
  stkCheckoutRequestId String?   @unique @map("stk_checkout_request_id")
  stkMerchantRequestId String?   @map("stk_merchant_request_id")
  stkResultCode        Int?      @map("stk_result_code")
  stkResultDesc        String?   @map("stk_result_desc")
  mpesaReceipt         String?   @map("mpesa_receipt") // deposit confirmation receipt
  paidAt               DateTime? @map("paid_at")

  // B2C (payout to provider, or refund to client)
  b2cConversationId String?   @unique @map("b2c_conversation_id")
  b2cResultCode     Int?      @map("b2c_result_code")
  b2cResultDesc     String?   @map("b2c_result_desc")
  b2cReceipt        String?   @map("b2c_receipt")
  releasedAt        DateTime? @map("released_at")
  refundedAt        DateTime? @map("refunded_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  events        MpesaEvent[]
  notifications Notification[]
  review        Review?
  deliveryProof DeliveryProof?

  @@index([clientId])
  @@index([providerId])
  @@index([escrowStatus])
  @@map("transactions")
}

// Provider's proof of delivery (photos + a note) — DoorDash-style. One per
// transaction; re-submitting replaces the note and adds/removes photos
// rather than creating a second proof.
model DeliveryProof {
  id            Int         @id @default(autoincrement())
  transactionId Int         @unique @map("transaction_id")
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  note          String?
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  photos DeliveryProofPhoto[]

  @@map("delivery_proofs")
}

model DeliveryProofPhoto {
  id              Int           @id @default(autoincrement())
  deliveryProofId Int           @map("delivery_proof_id")
  deliveryProof   DeliveryProof @relation(fields: [deliveryProofId], references: [id], onDelete: Cascade)
  url             String
  storageKey      String        @map("storage_key")
  position        Int           @default(0)
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([deliveryProofId])
  @@map("delivery_proof_photos")
}

// Raw log of every Daraja request and callback — idempotency guard + audit trail.
model MpesaEvent {
  id            Int            @id @default(autoincrement())
  transactionId Int?           @map("transaction_id")
  transaction   Transaction?   @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  kind          MpesaEventKind
  ref           String? // CheckoutRequestID or ConversationID
  resultCode    Int?           @map("result_code")
  payload       Json
  createdAt     DateTime       @default(now()) @map("created_at")

  @@index([transactionId])
  @@index([ref])
  @@map("mpesa_events")
}

// Minimal in-app notifications. Module 4 adds real-time push on top of this table.
model Notification {
  id            Int              @id @default(autoincrement())
  userId        Int              @map("user_id")
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          NotificationType
  title         String
  body          String
  transactionId Int?             @map("transaction_id")
  transaction   Transaction?     @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  readAt        DateTime?        @map("read_at")
  createdAt     DateTime         @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@map("notifications")
}

// ── Module 3 (E2EE messaging) — schema in place, endpoints pending ──
model Message {
  id               Int       @id @default(autoincrement()) @map("message_id")
  senderId         Int       @map("sender_id")
  sender           User      @relation("SentMessages", fields: [senderId], references: [id])
  receiverId       Int       @map("receiver_id")
  receiver         User      @relation("ReceivedMessages", fields: [receiverId], references: [id])
  encryptedPayload String    @map("encrypted_payload")
  deliveredAt      DateTime? @map("delivered_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([senderId, receiverId])
  @@map("messages")
}

// ── Phase 2 — ratings & reviews (threaded, likeable) ──
// One review per completed transaction; it is about the provider.
model Review {
  id            Int      @id @default(autoincrement())
  providerId    Int      @map("provider_id")
  provider      User     @relation("ReviewsAboutProvider", fields: [providerId], references: [id], onDelete: Cascade)
  authorId      Int      @map("author_id")
  author        User     @relation("ReviewsByAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  transactionId Int      @unique @map("transaction_id")
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  rating        Int // 1..5
  body          String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  replies ReviewReply[]
  likes   ReviewLike[]

  @@index([providerId])
  @@map("reviews")
}

model ReviewReply {
  id            Int      @id @default(autoincrement())
  reviewId      Int      @map("review_id")
  review        Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  authorId      Int      @map("author_id")
  author        User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentReplyId Int?     @map("parent_reply_id")
  parentReply   ReviewReply?  @relation("ReplyThread", fields: [parentReplyId], references: [id], onDelete: Cascade)
  childReplies  ReviewReply[] @relation("ReplyThread")
  body          String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  likes ReplyLike[]

  @@index([reviewId])
  @@map("review_replies")
}

model ReviewLike {
  reviewId  Int      @map("review_id")
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([reviewId, userId])
  @@map("review_likes")
}

model ReplyLike {
  replyId   Int         @map("reply_id")
  reply     ReviewReply @relation(fields: [replyId], references: [id], onDelete: Cascade)
  userId    Int         @map("user_id")
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now()) @map("created_at")

  @@id([replyId, userId])
  @@map("reply_likes")
}

// ── Phase 4 — reporting & moderation ──
model Report {
  id           Int              @id @default(autoincrement())
  reporterId   Int              @map("reporter_id")
  reporter     User             @relation("ReportsByReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType   ReportTargetType @map("target_type")
  targetId     Int              @map("target_id")
  reason       ReportReason
  detail       String?
  status       ReportStatus     @default(OPEN)
  reviewedById Int?             @map("reviewed_by_id")
  reviewedBy   User?            @relation("ReportsByModerator", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote   String?          @map("review_note")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@unique([reporterId, targetType, targetId])
  @@index([status])
  @@index([targetType, targetId])
  @@map("reports")
}

// "Report a bug" — problems with the app itself (not marketplace content, which
// is what Report is for). Anonymous reports are allowed: bugs can happen on the
// sign-in screen, before there is an account to attribute them to.
model BugReport {
  id          Int         @id @default(autoincrement())
  userId      Int?        @map("user_id")
  user        User?       @relation("BugReportsByUser", fields: [userId], references: [id], onDelete: SetNull)
  title       String
  description String
  severity    BugSeverity @default(MEDIUM)
  // Auto-captured by the client so the bug can be reproduced.
  pageUrl     String?     @map("page_url")
  userAgent   String?     @map("user_agent")
  // Only used for anonymous reports, so there is a way to follow up.
  contact     String?
  status      BugStatus   @default(OPEN)
  adminNote   String?     @map("admin_note")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("bug_reports")
}
