// Campus Connect V2 data model — see docs/data-model.md and proposal section 4.3.
// Four primary entities: Users, Listings, Messages, Transactions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection for the running app. On Supabase this is the transaction
  // pooler (port 6543) with ?pgbouncer=true.
  url       = env("DATABASE_URL")
  // Unpooled connection used only for migrations / introspection. For a plain
  // local Postgres, set DIRECT_URL equal to DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

enum CategoryType {
  DIGITAL
  PHYSICAL
}

enum ListingStatus {
  ACTIVE
  PAUSED
  HIRED
}

enum OtpPurpose {
  PHONE_VERIFY
  LOGIN
}

enum EscrowStatus {
  HELD
  RELEASED
  REFUNDED
}

model User {
  id            Int      @id @default(autoincrement()) @map("user_id")
  fullName      String   @map("full_name")
  phoneNumber   String   @unique @map("phone_number")
  passwordHash  String   @map("password_hash")
  phoneVerified Boolean  @default(false) @map("phone_verified")
  publicKey     String?  @map("public_key")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  listings             Listing[]
  otpCodes             OtpCode[]
  transactionsAsClient Transaction[] @relation("ClientTransactions")
  transactionsAsProvider Transaction[] @relation("ProviderTransactions")
  messagesSent         Message[]     @relation("SentMessages")
  messagesReceived     Message[]     @relation("ReceivedMessages")

  @@map("users")
}

model OtpCode {
  id         Int        @id @default(autoincrement())
  userId     Int        @map("user_id")
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String     @map("code_hash")
  purpose    OtpPurpose
  expiresAt  DateTime   @map("expires_at")
  consumedAt DateTime?  @map("consumed_at")
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([userId, purpose])
  @@map("otp_codes")
}

model Listing {
  id           Int           @id @default(autoincrement()) @map("listing_id")
  userId       Int           @map("user_id")
  owner        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryType CategoryType  @map("category_type")
  category     String
  title        String
  description  String
  price        Decimal       @db.Decimal(12, 2)
  location     String?
  status       ListingStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  transactions Transaction[]

  @@index([categoryType, status])
  @@index([createdAt])
  @@map("listings")
}

// ── Module 2 (HustleGuard escrow) — schema in place, endpoints pending ──
model Transaction {
  id              Int          @id @default(autoincrement()) @map("transaction_id")
  listingId       Int          @map("listing_id")
  listing         Listing      @relation(fields: [listingId], references: [id])
  clientId        Int          @map("client_id")
  client          User         @relation("ClientTransactions", fields: [clientId], references: [id])
  providerId      Int          @map("provider_id")
  provider        User         @relation("ProviderTransactions", fields: [providerId], references: [id])
  amount          Decimal      @db.Decimal(12, 2)
  escrowStatus    EscrowStatus @default(HELD) @map("escrow_status")
  mpesaCheckoutId String?      @map("mpesa_checkout_id")
  mpesaReceipt    String?      @map("mpesa_receipt")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@index([clientId])
  @@index([providerId])
  @@map("transactions")
}

// ── Module 3 (E2EE messaging) — schema in place, endpoints pending ──
model Message {
  id               Int       @id @default(autoincrement()) @map("message_id")
  senderId         Int       @map("sender_id")
  sender           User      @relation("SentMessages", fields: [senderId], references: [id])
  receiverId       Int       @map("receiver_id")
  receiver         User      @relation("ReceivedMessages", fields: [receiverId], references: [id])
  encryptedPayload String    @map("encrypted_payload")
  deliveredAt      DateTime? @map("delivered_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([senderId, receiverId])
  @@map("messages")
}
